if CONFIG["MAKENSISU"] and not CONFIG["MOZ_USE_MAKEFILE_INSTALLER_BUILD"]:
    FINAL_TARGET = "dist/bin"

    nsis_config_dir = f"{OBJDIR}/instgen"

    nsis_srcdir_files = CONFIG["NSIS_INSTALLER_FILES"] + [
        "nsis/defines.nsi.in",
    ]
    nsis_topsrcdir_files = (
        [
            f"/{CONFIG['MOZ_BRANDING_DIRECTORY']}/{f}"
            for f in CONFIG["NSIS_BRANDING_FILES"]
        ]
        + [
            f"/toolkit/mozapps/installer/windows/nsis/{f}"
            for f in CONFIG["NSIS_TOOLKIT_FILES"]
        ]
        + [f"/other-licenses/nsis/Plugins/{f}" for f in CONFIG["NSIS_CUSTOM_PLUGINS"]]
        + [f"/other-licenses/nsis/{f}" for f in CONFIG["NSIS_CUSTOM_UI"]]
    )

    nsis_locale_files = [
        f"/comm/mail/locales/en-US/installer/{f}"
        for f in [
            "custom.properties",
            "mui.properties",
            "override.properties",
        ]
    ]

    nsis_preprocess_locale = (
        "/toolkit/mozapps/installer/windows/nsis/preprocess-locale.py"
    )

    GeneratedFile(
        "nsis-stage.stamp",
        "nsis-stage.json",
        script="/python/mozbuild/mozbuild/action/nsis_stage.py",
        entry_point="generate",
        extra_deps=nsis_srcdir_files
        + nsis_topsrcdir_files
        + nsis_locale_files
        + [
            nsis_preprocess_locale,
            "!/buildid.h",
        ],
        flags=[
            f"--config-dir={nsis_config_dir}",
            f"--spec-out={OBJDIR}/nsis-stage.json",
            "--repack-l10n-dir=mail/installer",
        ]
        + [f"--install={SRCDIR}/{f}" for f in CONFIG["NSIS_INSTALLER_FILES"]]
        + [f"--install={TOPSRCDIR}{f}" for f in nsis_topsrcdir_files]
        + [
            f"--defines-in={SRCDIR}/nsis/defines.nsi.in",
            f"--defines-out={nsis_config_dir}/defines.nsi",
            f"--topsrcdir={TOPSRCDIR}",
            f"--preprocess-locale-script={TOPSRCDIR}{nsis_preprocess_locale}",
            # Localized repacks stage their locale through `l10n_repackage`.
            f"--locale-arg={TOPSRCDIR}/comm/mail/locales/en-US/installer",
            "--ab-cd=en-US",
            "--preprocess-locale",
            f"--defines-string={CONFIG['NSIS_INSTALLER_DEFINES']}",
            "-DAB_CD=en-US",
            f"-DTOPOBJDIR={TOPOBJDIR}",
        ],
    )

    nsis_build_flags = [
        f"--config-dir={nsis_config_dir}",
        f"--makensis={CONFIG['MAKENSISU']}",
    ] + [f"--makensis-flag={f}" for f in CONFIG["MAKENSISU_FLAGS"].split()]

    GeneratedFile(
        "helper.exe",
        script="/python/mozbuild/mozbuild/action/nsis_build.py",
        entry_point="generate",
        extra_deps=["!nsis-stage.stamp"],
        flags=nsis_build_flags + ["--nsi=uninstaller.nsi"],
    )
    FINAL_TARGET_FILES.uninstall += ["!helper.exe"]

    if CONFIG["MOZ_MAINTENANCE_SERVICE"]:
        GeneratedFile(
            "maintenanceservice_installer.exe",
            script="/python/mozbuild/mozbuild/action/nsis_build.py",
            entry_point="generate",
            extra_deps=["!nsis-stage.stamp"],
            flags=nsis_build_flags + ["--nsi=maintenanceservice_installer.nsi"],
        )
        FINAL_TARGET_FILES += ["!maintenanceservice_installer.exe"]

offline-dialog-title = Offline settings

autodetect-connection-label =
    .label = Automatically switch modes when an internet connection is found
    .accesskey = d

offline-startup-label = When opening { -brand-short-name }:

status-radio-last-used =
    .label = Use the last-used connection mode
    .accesskey = U

status-radio-ask-connect =
    .label = Ask whether to connect online
    .accesskey = k

status-radio-start-online =
    .label = Start online
    .accesskey = l

status-radio-start-offline =
    .label = Start offline
    .accesskey = f

going-online-prompt = Send messages waiting in your Outbox

going-online-send =
    .label = Yes, send automatically
    .accesskey = Y

going-online-keep =
    .label = No, keep in Outbox
    .accesskey = N

going-online-ask-send =
    .label = Ask before sending
    .accesskey = s

going-offline-prompt = Do you want to download messages to read offline?

going-offline-download =
    .label = Yes, download automatically
    .accesskey = e

going-offline-keep =
    .label = No, do not download
    .accesskey = o

going-offline-ask-download =
    .label = Ask before downloading
    .accesskey = a

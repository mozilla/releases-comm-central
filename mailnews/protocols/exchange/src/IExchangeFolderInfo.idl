#include "nsISupports.idl"

/**
 * Queries about an Exchange folder's local state.
 */
[scriptable, uuid(d097f19a-d3d3-4db9-b571-abfd263cfa7b)]
interface IExchangeFolderInfo : nsISupports
{
  /**
   * Get the server IDs of messages currently stored in this folder.
   */
  Array<AUTF8String> getCurrentMessageIds();
};

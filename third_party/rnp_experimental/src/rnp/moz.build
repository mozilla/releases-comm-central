Program("rnp-cli-experimental")

include("../../../rnpdefs.mozbuild")
include("../../experimental-features.mozbuild")

USE_LIBS += ["rnp_experimental"]

LOCAL_INCLUDES += [
    "!../lib",
    "..",
    "../../include",
    "../common",
    "../lib",
]

if CONFIG["OS_TARGET"] == "WINNT":
    CXXFLAGS += ["/std:c++20"]
else:
    CXXFLAGS += ["-std=c++20"]

# More recent versions of RNP replaced json-c with the bundled header-only nlohmann/json.
LOCAL_INCLUDES += ["../lib/nlohmann"]
LDFLAGS += ["-Wl,-rpath,$ORIGIN"]

SOURCES += [
    "../common/file-utils.cpp",
    "../common/str-utils.cpp",
    "../common/time-utils.cpp",
    "../lib/logging.cpp",
    "../rnpkeys/tui.cpp",
    "fficli.cpp",
    "rnp.cpp",
    "rnpcfg.cpp",
]

if CONFIG["CC_TYPE"] == "clang-cl":
    OS_LIBS += ["shell32"]

    SOURCES += [
        "/comm/third_party/niwcompat/getopt.c",
    ]
    SOURCES["rnpcfg.cpp"].flags += [
        "-FI",
        "%s/comm/third_party/niwcompat/extra_include.h" % TOPSRCDIR,
    ]
    DEFINES["MOZILLA_CONFIG_H"] = True
    DEFINES["_CRT_SECURE_NO_WARNINGS"] = True
